[Unit]
Description=sh2loop — ESTree backend repair loop
Documentation=file://__SH2LOOP_ROOT__/AGENTS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__SH2LOOP_ROOT__
# supervise.sh restarts the loop forever; see systemd/sh2estree.service for the
# canonical unit. This file used to say User=ai and /nvme/ai/sh2loop, neither
# of which exists here, so it described a service that was never running.
ExecStart=__SH2LOOP_ROOT__/harness/supervise.sh \
  --name estree \
  --log __SH2LOOP_ROOT__/loop-estree.log \
  --pidfile __SH2LOOP_ROOT__/loop-estree-worker.pid \
  -- \
  /usr/bin/perl __SH2LOOP_ROOT__/main_loop_estree.pl
Restart=always
RestartSec=10
StandardOutput=append:__SH2LOOP_ROOT__/loop-estree.log
StandardError=append:__SH2LOOP_ROOT__/loop-estree.log

[Install]
WantedBy=default.target
