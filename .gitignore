# built frontend binaries — build-on-test (Makefiles: test: build); never commit
# estree-runner temp dirs (scratch — never commit)
harness/.estree-run-*/
# c-frontend generated templates (worker output — never commit)
templates/

# bat frontend cmd-reference staging (regenerated by capture-refs.sh)
.gate-tmp/
gate-reports/
triage/
# frontend worker loop logs / pid files (never commit)
loop-*.log
loop-*.pid
# worker-pool slot accounting (harness/WorkerPool.pm — runtime state)
/.workers/
# model-rotation runtime state: epoch, invocations/gates JSONL, lock
/.worker-model/
# ts-node-gap detector build artifact (rebuilt on demand by ts-node-gap.sh)
# refused-refresh worker state (REFUSED-REFRESH.md — runtime stamps/cursors)
/.build-lock/

# ── repo-size hygiene (see GIT_SIZE_CLEANUP.md) ─────────────────────
# Rust/Cargo build dirs (syn-coverage etc. were committed by accident)
# built frontend wasm (build-on-test artifacts, same policy as the binaries above)
# tree-sitter GENERATED parser tables (regenerated from grammars/, never hand-edited)
# one-off run logs that leaked into the root
/.check_sh_files_run.log
/du-xh.log
/.stash_history.log
junk/backends/


# ── shell-accident outputs (same policy as sh2perl/.gitignore) ──────
/junk/&[0-9]
/junk/-
/junk/[0-9]

# ── root-level shell-accident outputs: redirection / expansion / probe scratch ──
# (were tracked by accident; removed with `git rm --cached`, working-tree files kept)
# `2c` and `2js` are real scripts (tracked, unaffected); `/2j`/`/2p` below are typo duplicates.
/&*
/-
/[0-9]*
/"*
/,rhs:*
/5}]*
/STDERR,*
/Sanitized:*
/Uppercase:*
/$__sh2_rd0
/MYVAR=*
/MY_VAR=*
/readonly *
/sh: *
/m_out=*
/.hidden
/.neww
/temp_file*.txt
/a.txt
/b.txt
/a.sh
/s.sh
/b.log
/c.dat
/js.out
/alpha
/beta
/gamma
/file.txt
/note.txt
/comparison*.txt
/config.txt
/users.txt
/errors.log
/final_result.txt
/f
/__ps_tmp*
/__tmp_*.pl
/pc-*.pl
/pc_analyze-*.pl
/*.plist
*.swp
*~

# ── scratch typo-duplicates of real scripts ──
/2j
/2p
/sj
harness/f

# ── generated run-state dirs (never commit) ──
/log-archive/
/.shir-verify-target/
# core worker's isolated verifier: the temporary wrapper crate it generates
# (harness/core_verify.sh) plus its isolated cargo target and binary.
.core-verify/
.core-verify-target/

otranspilerl/target/
# otranspilerl/target is a SYMLINK to /mnt/wsl/tmpbtrfs/target/otranspiler
# (build artifacts were moved to the scratch device on 2026-10-08). The
# trailing-slash pattern above only matches a real directory, so ignore the
# symlink form explicitly too — otherwise `git status` reports it untracked
# and a `git add .` would commit a machine-specific absolute path.
otranspilerl/target

# Same symlink-form problem for every redirected cargo target. The heavy
# build caches were moved to the btrfs scratch device (/mnt/wsl/tmpbtrfs/
# target/<name>) and each original path is now a symlink. A trailing-slash
# ignore does not match a symlink, so name them explicitly. The submodule's
# own `target/` rule covers its real directories; these cover the links the
# superproject sees.
sh2perl/backends/c/target
sh2perl/backends/rust/target
sh2perl/backends/fish/target
sh2perl/backends/perl/target
sh2perl/backends/sh/target
sh2perl/backends/java/target
sh2perl/backends/zsh/target
sh2perl/backends/js/target
sh2perl/backends/core/target
sh2perl/backends/estree/target
sh2perl/backends/zig/target
sh2perl/backends/python/target
.core-verify-target
.core-fix-target
.core-prefix-target
/target
bash-o4/target/
# root cargo target — was committed wholesale (265 MB, 505 files) before
# the ignore existed; see docs/CLEAN_GIT.md
/target/
target-core/

# python bytecode (transpiler bench scratch — never commit)
__pycache__/
*.pyc

# agent session logs / scratch (never commit)
.pir/
.scratch/
