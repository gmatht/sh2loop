+	// a count (a number), the rest filter (<= the input)
+	lastFlag := ""
+	if arr, ok := last.(*ArrowE); ok {
+		for _, st := range arr.Body {
+			es, ok := st.(*ExprS)
+			if !ok {
+				continue
+			}
+			c, ok := es.Expr.(*CallE)
+			if !ok || len(c.Args) < 2 {
