#!/usr/bin/env bash
# fail-go — Go→JS / Go→Rust end-to-end gate (TRANSLATE_ONE_APPLICATION dog-food).
#
# For every Go source file (default: frontends/go-sh/testdata/*.go — the
# frontend's corpus ladder), the oracle is the SOURCE's native behavior
# (`go run` of the program; snippets are wrapped with package main + a
# detected-imports stub, mirroring translate_one_application.sh run_native):
#
#   JS  : go-sh --shir --raw → debashc --shir-in-estree → estree-runner.mjs
#   Rust: go-sh --shir --raw → otranspilerl --target rust → rustc → run
#
# A test passes only on its own verdict (oracle == translated stdout),
# never by render success alone. No failing-test allowlist: a red probe is
# the pipeline's gap signal (the TRANSLATE_ONE_APPLICATION fix loop).
#
# FLAKINESS GUARD (re-verification, NOT an allowlist): a single transient
# infra failure — a `go run` oracle that dies (rc=124 timeout / compile
# hiccup), an estree-runner node killed or returning empty under load, or
# the shared target dir's debashc being churned by another worker — can
# false-red one test as js=MISMATCH (e.g. the 18:47:06 t16-t19 flake,
# green 17s later and in 39 consecutive runs). one() re-runs the whole
# per-test measurement ONCE before trusting a non-PASS verdict (the same
# re-check the operator does by hand), and the second attempt's verdict is
# final — a real transpiler bug reproduces on retry and still counts as a
# failure. Deterministic frontend rejections (EMIT-FAIL / REFUSE) are not
# retried. The per-test oracle rc is surfaced in the summary for
# diagnosis, so a recurring infra flake stays visible.
#
# Usage: ./fail-go [--gate] [--rust] [--app FILE.go] [PREFIX]
#   default    report per-file {file, oracle, js, rust, reason}
#   --gate     exit 1 on any failure (js unless --rust; both with --rust)
#   --rust     also (or only) run the rust target
#   --app FILE run a single app (the dog-food integration test) + the corpus
#   PREFIX     filename prefix filter (like ./fail)
set -u

ROOT="$(cd "$(dirname "$0")" && pwd)"
GOSH="$ROOT/frontends/go-sh/go-sh"
DEBASHC="$ROOT/sh2perl/target/debug/debashc"
OTRANS="$ROOT/otranspilerl/target/debug/otranspilerl-cli"
# the rust BACKEND renderer — the worktree's debashc --shir-in-rust
# (harness/triage.sh + harness/repro-pair.sh use the same binary). The
# otranspilerl-cli fallback links the MAIN checkout's stale renderer
# copy — used only when the worktree binary isn't built (standalone
# runs outside the backend gate, which builds it first).
RUSTBIN="$ROOT/sh2perl/backends/rust/target/debug/debashc"
[ -x "$RUSTBIN" ] || RUSTBIN="$OTRANS"
RUNNER="$ROOT/harness/estree-runner.mjs"
CORPUS="$ROOT/frontends/go-sh/testdata"
TIMEOUT=15
JOBS="$(nproc 2>/dev/null || echo 4)"

GATE=0; RUST=0; APP=""; PREFIX=""
for a in "$@"; do
  case "$a" in
    --gate) GATE=1 ;;
    --rust) RUST=1 ;;
    --app) APP="${2:-}" ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) [ -z "$PREFIX" ] && PREFIX="$a" ;;
  esac
done
[ -n "$APP" ] && shift 2

# ── A1-ingress oracle ────────────────────────────────────────────────
# The main checkout's target dir is SHARED with the core/estree/sh
# workers (build-lock.sh default), and they churn or wipe it (cargo
# clean, rebuilds, lockfile revert/stale serde caches) — the binary can
# vanish between `make test`'s debashc-oracle check and this script's
# run. A missing oracle must report "oracle unavailable", never a
# misleading "A1->estree failed" (rc=127 masquerades as a renderer
# rejection). Rebuild through the sanctioned choke point (backend role:
# waits up to 1800s, never preempts) — same as make debashc-oracle,
# including the documented stale-cache retry (serde 1.0.229 artifacts
# vs a reverted 1.0.226 lockfile; cleaning just those packages recovers
# without nuking the shared dep cache).
ensure_oracle() {
  [ -x "$DEBASHC" ] && return 0
  echo "oracle $(basename "$DEBASHC") missing — rebuilding via build-lock.sh" >&2
  if "$ROOT/harness/build-lock.sh" --role backend -- cargo build \
      --manifest-path "$ROOT/sh2perl/Cargo.toml" --bin debashc >&2; then
    echo "oracle rebuilt" >&2
    return 0
  fi
  echo "oracle build failed — stale serde cache? cleaning serde artifacts and retrying once" >&2
  if "$ROOT/harness/build-lock.sh" --role backend -- cargo clean \
        --manifest-path "$ROOT/sh2perl/Cargo.toml" -p serde_derive -p serde -p serde_core >&2 \
      && "$ROOT/harness/build-lock.sh" --role backend -- cargo build \
        --manifest-path "$ROOT/sh2perl/Cargo.toml" --bin debashc >&2; then
    echo "oracle rebuilt after serde cache clean" >&2
    return 0
  fi
  echo "FAIL (oracle unavailable — could not build debashc; the core tree may be mid-WIP)" >&2
  return 1
}
ensure_oracle || exit 1

# ── helpers ──────────────────────────────────────────────────────────
wrap_go() { # file -> wrapped program on stdout (if it needs wrapping)
  local f="$1" imports=""
  grep -q 'func main(' "$f" && { cat "$f"; return; }
  grep -q 'fmt\.'       "$f" && imports="$imports\n\t\"fmt\""
  grep -q 'strings\.'   "$f" && imports="$imports\n\t\"strings\""
  grep -q 'bufio\.'     "$f" && imports="$imports\n\t\"bufio\""
  grep -qE 'os\.(Getenv|WriteFile|Setenv|Stat|Stdin|Stdout|Stderr|ReadFile|Args)' "$f" \
    && imports="$imports\n\t\"os\""
  grep -q 'exec\.'      "$f" && imports="$imports\n\t\"os/exec\""
  grep -q 'strconv\.'   "$f" && imports="$imports\n\t\"strconv\""
  grep -q 'filepath\.'  "$f" && imports="$imports\n\t\"path/filepath\""
  grep -q 'bytes\.'     "$f" && imports="$imports\n\t\"bytes\""
  grep -q 'sort\.'      "$f" && imports="$imports\n\t\"sort\""
  grep -q 'time\.'      "$f" && imports="$imports\n\t\"time\""
  { printf 'package main\n\nimport (\n%b\n)\n\nfunc main() {\n' "$imports"; cat "$f"; printf '\n}\n'; }
}

measure_once() { # f -> run oracle+JS(+Rust) ONCE; store MO MORC MJ MJRC MJv MR MRRC MRv MREASON
  local f="$1" wrp tmp o orc a1 jrc e rs rsrc reason="" R= J= rc
  wrp=$(wrap_go "$f")
  tmp=$(mktemp -d)
  printf '%s\n' "$wrp" > "$tmp/main.go"
  # the app oracle needs the go-sh module context: the golib import
  # (`github.com/gmatht/sh2loop/frontends/go-sh`) resolves only through
  # go.mod replace directives (a dependency's own replaces are ignored —
  # the main module must repeat them). Without this, `go run` dies with
  # "no required module provides package ..." and the oracle rc=1
  # masquerades as an app failure. The app is also BUILT (not `go run`):
  # `go run` wraps any non-zero exit as rc=1 + "exit status N" on stderr,
  # hiding the app's true exit code from the gate's rc comparison.
  if grep -q 'gmatht/sh2loop/frontends/go-sh' "$f"; then
    printf 'module app\n\ngo 1.21\n\nrequire github.com/gmatht/sh2loop/frontends/go-sh v0.0.0\n\nreplace github.com/gmatht/sh2loop/frontends/go-sh => %s\n\nreplace github.com/gmatht/sh2loop/frontends/shir-emit-go => %s\n' \
      "$ROOT/frontends/go-sh" "$ROOT/frontends/shir-emit-go" > "$tmp/go.mod"
    if (cd "$tmp" && timeout "$TIMEOUT" go build -o appbin main.go 2>/dev/null); then
      MO="$(cd "$tmp" && timeout "$TIMEOUT" ./appbin </dev/null 2>/dev/null)"; MORC=$?
    else
      MO=""; MORC=1
    fi
  else
    MO="$(cd "$tmp" && timeout "$TIMEOUT" go run main.go </dev/null 2>/dev/null)"; MORC=$?
  fi
  MO=$(printf '%s' "$MO" | tr '\n' '\036')   # record separator, keep exact bytes-ish
  # ── JS target ──
  a1=$(timeout "$TIMEOUT" "$GOSH" --shir "$f" --raw 2>/dev/null); jrc=$?
  if [ $jrc -ne 0 ]; then J="EMIT-FAIL"; reason="frontend cannot parse/lower";
  elif [ -z "$a1" ]; then J="REFUSE";
  else
    e=$(printf '%s' "$a1" | "$DEBASHC" --shir-in-estree - 2>/dev/null); jrc=$?
    if [ $jrc -ne 0 ]; then J="TARGET-ERR"; reason="A1->estree failed";
    else
      # capture node's rc directly (a pipeline's rc is the LAST command's
      # — `tr` would mask the JS exit code, which the verdict now compares
      # against the oracle's).
      (cd "$tmp" && timeout "$TIMEOUT" node "$RUNNER" /dev/stdin --source "$f" <<<"$e" 2>/dev/null) > "$tmp/js.out"; jrc=$?
      J=$(tr '\n' '\036' < "$tmp/js.out")
      [ $jrc -ge 128 ] && { J="CRASH"; reason="js crashed (rc $jrc)"; }
    fi
  fi
  # ── Rust target ──
  if [ "$RUST" = 1 ]; then
    if [ $jrc -eq 0 ] && [ -n "$a1" ]; then
      if [ "$RUSTBIN" = "$OTRANS" ]; then
        rs=$(printf '%s' "$a1" | "$RUSTBIN" - - --target rust 2>/dev/null); rsrc=$?
      else
        rs=$(printf '%s' "$a1" | "$RUSTBIN" --shir-in-rust - 2>/dev/null); rsrc=$?
      fi
      if [ $rsrc -ne 0 ]; then R="TARGET-ERR";
      else
        printf '%s\n' "$rs" > "$tmp/main.rs"
        # -C opt-level=1: without it the rust leg is the ONLY unoptimized
        # one — the oracle is `go run` (compiled with optimization) and
        # node JITs the estree output. Debug-mode TLS-static access is
        # ~10x slower; a faithful 50M-iteration loop (t79_go_stmt) would
        # blow the 15s run timeout at -O0. opt-level=1 also wraps i64
        # overflow like bash (debug builds panic).
        if (cd "$tmp" && timeout "$TIMEOUT" rustc -C opt-level=1 -o main.rsbin main.rs 2>/dev/null); then
          R=$(cd "$tmp" && timeout "$TIMEOUT" ./main.rsbin </dev/null 2>/dev/null | tr '\n' '\036'); rsrc=$?
          [ $rsrc -ge 128 ] && R="CRASH"
        else R="RUST-COMPILE-FAIL"; fi
      fi
    else R="n/a"; fi
  else R="n/a"; fi
  # ── verdicts vs the oracle ──
  # normalize: command substitution strips the oracle's trailing newline,
  # but the JS/Rust pipes converted it to a record separator first — strip
  # a trailing separator from both sides before comparing.
  o="${MO%$'\036'}"; MO="$o"
  J="${J%$'\036'}"; R="${R%$'\036'}"
  # PASS requires stdout AND exit code to match the oracle (the app's
  # `os.Exit(2)` on usage errors is part of its observable behavior).
  if [ "$MO" = "$J" ] && [ "$MORC" = "$jrc" ]; then Jv=PASS; else [ "$J" = "EMIT-FAIL" -o "$J" = "REFUSE" -o "$J" = "TARGET-ERR" -o "$J" = "CRASH" ] && Jv="$J" || Jv=MISMATCH; fi
  if [ "$MO" = "$R" ]; then Rv=PASS; else [ "$R" = "EMIT-FAIL" -o "$R" = "TARGET-ERR" -o "$R" = "RUST-COMPILE-FAIL" -o "$R" = "CRASH" -o "$R" = "n/a" ] && Rv="$R" || Rv=MISMATCH; fi
  rm -rf "$tmp"
  MJ="$J"; MJRC=$jrc; MJv="$Jv"; MREASON="$reason"
  MR="$R"; MRRC=$rsrc; MRv="$Rv"
}

one() { # file -> "file\toracle\tjs\trust\treason" (tab-separated)
  local f="$1" bn
  bn=$(basename "$f")
  measure_once "$f"
  # FLAKINESS GUARD: one re-verification before trusting a non-PASS verdict
  # (see header). A genuine bug reproduces on the retry and still fails;
  # deterministic frontend rejections are not retried. The second attempt
  # (or the first, when it passed) is what the gate reports.
  if [ "$MJv" != PASS ] && [ "$MJv" != EMIT-FAIL ] && [ "$MJv" != REFUSE ]; then
    local first_reason="$MREASON"
    measure_once "$f"
    if [ "$MJv" != PASS ]; then
      MREASON="[flake-retry: first=$first_reason] ${MREASON:-still failing}"
    else
      MREASON="[flake-retry: first=$first_reason] passed on re-check"
    fi
  fi
  # surface the per-test oracle rc (+ js rc) for infra-flake diagnosis
  if [ "$MJv" != PASS ]; then MREASON="${MREASON:+$MREASON }(oracle_rc=$MORC js_rc=$MJRC)"; fi
  printf '%s\t%s\t%s\t%s\t%s\n' "$bn" "$MJv" "$MRv" "$MORC" "$MREASON"
}

# ── gather files ─────────────────────────────────────────────────────
files=()
if [ -n "$APP" ]; then
  [ -f "$APP" ] || { echo "fail-go: no such app: $APP" >&2; exit 2; }
  files+=("$APP")
fi
for f in "$CORPUS"/*.go; do
  [ -f "$f" ] || continue
  bn=$(basename "$f")
  [ -n "$PREFIX" ] && [[ "$bn" == "$PREFIX"* ]] || [ -z "$PREFIX" ] || continue
  files+=("$f")
done

export -f one wrap_go measure_once
export GOSH DEBASHC OTRANS RUSTBIN RUNNER TIMEOUT RUST ROOT
# ── run ──────────────────────────────────────────────────────────────
tmpd=$(mktemp -d)
printf '%s\n' "${files[@]}" | xargs -P "$JOBS" -I{} bash -c 'one "$1"' _ {} > "$tmpd/out.tsv" 2>/dev/null

js_pass=0; js_fail=0; rs_pass=0; rs_fail=0; total=0
while IFS=$'\t' read -r bn Jv Rv orc reason; do
  total=$((total+1))
  [ "$Jv" = PASS ] && js_pass=$((js_pass+1)) || js_fail=$((js_fail+1))
  if [ "$RUST" = 1 ]; then [ "$Rv" = PASS ] && rs_pass=$((rs_pass+1)) || rs_fail=$((rs_fail+1)); fi
  if [ "$Jv" != PASS ] || { [ "$RUST" = 1 ] && [ "$Rv" != PASS ] && [ "$Rv" != n/a ]; }; then
    printf '  %-28s js=%-12s rust=%-16s %s\n' "$bn" "$Jv" "$Rv" "$reason"
  fi
done < "$tmpd/out.tsv"
if [ "$RUST" = 1 ]; then
  echo "=== fail-go: $js_pass/$total js pass, $rs_pass/$total rust pass ==="
  printf '%s fail-go: %s/%s js pass, %s/%s rust pass\n' "$(date +%FT%T)" "$js_pass" "$total" "$rs_pass" "$total" >> "$ROOT/gate-reports/go-js.report"
else
  echo "=== fail-go: $js_pass/$total js pass (rust not measured — pass --rust) ==="
  printf '%s fail-go: %s/%s js pass (rust n/a — run with --rust)\n' "$(date +%FT%T)" "$js_pass" "$total" >> "$ROOT/gate-reports/go-js.report"
fi
rm -rf "$tmpd"
[ "$GATE" = 1 ] && { [ "$js_fail" -gt 0 ] || { [ "$RUST" = 1 ] && [ "$rs_fail" -gt 0 ]; }; } && exit 1
exit 0
