#!/usr/bin/env perl
use strict;
use warnings;
use Cwd qw(abs_path getcwd);
use File::Basename qw(basename dirname);
use File::Path qw(make_path remove_tree);
use File::Temp qw(tempdir);
use POSIX qw(:sys_wait_h);

$| = 1;

my $root = dirname(abs_path($0));
my $sh2perl = "$root/sh2perl";
my $debashc = "$sh2perl/target/debug/debashc";
my $examples = "$sh2perl/examples";
my $timeout_per_test = 30;   # seconds per individual test
my $ncpus = 1;
if (open my $fh, '<', '/proc/cpuinfo') {
    my @lines = grep { /^processor\s*:/ } <$fh>;
    $ncpus = scalar @lines || 1;
    close $fh;
}
my $jobs = int($ncpus / 2);
$jobs = 1 if $jobs < 1;

my @all_tests = glob "$examples/*.sh";
@all_tests = sort @all_tests;

# If a prefix argument is given, filter tests
if (@ARGV) {
    my $prefix = $ARGV[0];
    @all_tests = grep { index(basename($_), $prefix) != -1 } @all_tests;
}

my $total   = scalar @all_tests;
my $passed  = 0;
my $failed  = 0;
my $timed   = 0;
my @results = ();  # { file => name, status => 'PASS'|'FAIL'|'TIMEOUT', detail => '...' }

print "Running $total tests, $jobs parallel workers, ${timeout_per_test}s timeout each\n";
print "Examples dir: $examples\n";
print "Debashc: $debashc\n";
print "----------------------------------------\n";

# Build debashc first (quiet — warnings suppressed)
print "Building debashc...\n";
my $build_out = `cd '$sh2perl' && cargo build --bin debashc 2>&1`;
if ($? != 0) {
    print $build_out;
    die "Build failed\n";
}
print "Build complete.\n\n";

my $work_dir = tempdir("failtest-XXXXXXXX", CLEANUP => 1, DIR => "/tmp");

# Serial test runner (simple, reliable)
for my $i (0 .. $#all_tests) {
    my $test_file = $all_tests[$i];
    my $test_name = basename($test_file);
    my $test_num  = $i + 1;
    print "[$test_num/$total] $test_name ... ";

    # Create isolated tmp directory for this test.
    # debashc's run_shell_script runs scripts in ./examples/ relative to its CWD,
    # so the tmp dir needs an examples/ subdirectory with the test file in it.
    my $tmp_dir = "$work_dir/test_$i";
    make_path($tmp_dir);
    # Symlink the real examples/ so the script can read sibling files
    symlink($examples, "$tmp_dir/examples") or die "symlink $tmp_dir/examples: $!";

    my $isolated_test_file = "$tmp_dir/examples/$test_name";

    # Run debashc with timeout
    my $pid = fork;
    if (!defined $pid) { die "fork: $!"; }

    if ($pid == 0) {
        # Child: run debashc from the tmp dir so side effects (new temp files
        # written by the shell script) land in $tmp_dir, not in the real examples/.
        chdir $tmp_dir or die "chdir $tmp_dir: $!";
        open STDOUT, '>', "$tmp_dir/stdout.txt" or die "write stdout: $!";
        open STDERR, '>', "$tmp_dir/stderr.txt" or die "write stderr: $!";
        exec $debashc, '--test-file', 'perl', $isolated_test_file;
        die "exec: $!";
    }

    # Parent: wait with timeout
    my $deadline = time() + $timeout_per_test;
    my $timed_out = 0;
    my $child_exit = -1;
    while (1) {
        my $remaining = $deadline - time();
        if ($remaining <= 0) {
            $timed_out = 1;
            kill('TERM', $pid);
            sleep(0.1);
            kill('KILL', $pid) if kill(0, $pid);
            my $reaped = waitpid($pid, 0);
            $child_exit = $? >> 8 if $reaped == $pid;
            last;
        }
        my $kid = waitpid($pid, WNOHANG);
        if ($kid == $pid) {
            $child_exit = $? >> 8;
            last;
        }
        select(undef, undef, undef, 0.1);
    }
    # Reap if not already reaped
    if (!$timed_out && waitpid($pid, WNOHANG) == 0) {
        my $reaped = waitpid($pid, 0);
        $child_exit = $? >> 8 if $reaped == $pid;
    } elsif ($timed_out && kill(0, $pid)) {
        kill('KILL', $pid);
        waitpid($pid, 0);
    }

    # Read results
    my $stdout = '';
    if (open my $fh, '<', "$tmp_dir/stdout.txt") {
        local $/; $stdout = <$fh>; close $fh;
    }
    my $stderr = '';
    if (open my $fh, '<', "$tmp_dir/stderr.txt") {
        local $/; $stderr = <$fh>; close $fh;
    }

    # Determine status
    if ($timed_out) {
        print "TIMEOUT (${timeout_per_test}s)\n";
        $timed++;
        push @results, { file => $test_name, status => 'TIMEOUT', detail => "exceeded ${timeout_per_test}s" };
    } elsif ($child_exit == 0) {
        print "TEST PASSED\n";
        $passed++;
        push @results, { file => $test_name, status => 'PASS', detail => '' };
    } else {
        # Get failure reason
        my $reason = $stderr || $stdout;
        $reason =~ s/\n/ /g;
        $reason = substr($reason, 0, 200);
        print "FAIL (exit=$child_exit): $reason\n";
        $failed++;
        push @results, { file => $test_name, status => 'FAIL', detail => "exit=$child_exit $reason" };
    }

    # Cleanup tmp dir
    remove_tree($tmp_dir);
}

print "\n========================================\n";
print "TESTS COMPLETED: $passed passed, " . ($failed + $timed) . " failed out of $total\n";
print "========================================\n";

if ($failed || $timed) {
    print "\nFAILED TESTS:\n";
    for my $r (@results) {
        next if $r->{status} eq 'PASS';
        my $reason = $r->{status} eq 'TIMEOUT' ? "Timed out after ${timeout_per_test}s" : $r->{detail};
        printf "  FAIL: %s [perl] — %s\n", $r->{file}, $reason;
    }
}

exit ($failed || $timed ? 1 : 0);
