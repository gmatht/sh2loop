#!/usr/bin/env perl
use strict;
use warnings;
use Cwd qw(abs_path getcwd);
use File::Basename qw(basename dirname);
use File::Path qw(make_path remove_tree);
use File::Temp qw(tempdir);
use POSIX qw(:sys_wait_h);

$| = 1;

my $root = dirname(abs_path($0));
my $sh2perl = "$root/sh2perl";
my $debashc = "$sh2perl/target/debug/debashc";
my $examples = "$sh2perl/examples";
my $timeout_per_test = 30;   # seconds per individual test
my $ncpus = 1;
if (open my $fh, '<', '/proc/cpuinfo') {
    my @lines = grep { /^processor\s*:/ } <$fh>;
    $ncpus = scalar @lines || 1;
    close $fh;
}
my $jobs = int($ncpus / 2);
$jobs = 1 if $jobs < 1;

my @all_tests = glob "$examples/*.sh";
@all_tests = sort @all_tests;

if (@ARGV) {
    my $prefix = $ARGV[0];
    @all_tests = grep { index(basename($_), $prefix) != -1 } @all_tests;
}

my $total   = scalar @all_tests;
my $passed  = 0;
my $failed  = 0;
my $timed   = 0;
my $side_effect_fails = 0;
my @results = ();

# ── Side-effect checking helpers ─────────────────────────────────────

sub extract_tmp_paths {
    my ($file) = @_;
    open my $fh, '<', $file or return [];
    my $content = do { local $/; <$fh> };
    close $fh;
    my @paths;
    while ($content =~ m{/tmp/[-_.a-zA-Z0-9/+*?]+}g) {
        my $path = $&;
        next if $path =~ /[*?]/;
        next if $path =~ /XXXXXX/;
        next if $path =~ m{/tmp/\*};
        next if $path =~ m{/tmp/temp_};
        $path =~ s{[^a-zA-Z0-9_./+-]\$}{};
        push @paths, $path;
    }
    my %seen;
    @paths = grep { !$seen{$_}++ } @paths;
    return \@paths;
}

sub snapshot_paths {
    my ($paths) = @_;
    my %snap;
    for my $p (@$paths) {
        my @matches = glob $p;
        if (@matches) {
            for my $m (@matches) {
                if (-f $m && !-l $m) {
                    my $hash = `sha256sum "$m" 2>/dev/null`;
                    chomp $hash;
                    $snap{$m} = $hash;
                } else {
                    $snap{$m} = 'EXISTS';
                }
            }
        } elsif (-e $p) {
            if (-f $p && !-l $p) {
                my $hash = `sha256sum "$p" 2>/dev/null`;
                chomp $hash;
                $snap{$p} = $hash;
            } else {
                $snap{$p} = 'EXISTS';
            }
        } else {
            $snap{$p} = 'MISSING';
        }
    }
    return \%snap;
}

# ── Run a single test (fork + exec) ─────────────────────────────────

sub run_one_test {
    my ($test_file, $test_name, $test_num, $work_dir) = @_;

    my $tmp_dir = "$work_dir/test_$test_num";
    make_path($tmp_dir);
    symlink($examples, "$tmp_dir/examples") or die "symlink $tmp_dir/examples: $!";

    my $isolated_test_file = "$tmp_dir/examples/$test_name";

    my $pid = fork;
    if (!defined $pid) { die "fork: $!"; }

    if ($pid == 0) {
        chdir $tmp_dir or die "chdir $tmp_dir: $!";
        open STDOUT, '>', "$tmp_dir/stdout.txt" or die "write stdout: $!";
        open STDERR, '>', "$tmp_dir/stderr.txt" or die "write stderr: $!";
        exec $debashc, '--test-file', 'perl', $isolated_test_file;
        die "exec: $!";
    }

    my $deadline = time() + $timeout_per_test;
    my $timed_out = 0;
    my $child_exit = -1;
    while (1) {
        my $remaining = $deadline - time();
        if ($remaining <= 0) {
            $timed_out = 1;
            kill('TERM', $pid);
            sleep(0.1);
            kill('KILL', $pid) if kill(0, $pid);
            my $reaped = waitpid($pid, 0);
            $child_exit = $? >> 8 if $reaped == $pid;
            last;
        }
        my $kid = waitpid($pid, WNOHANG);
        if ($kid == $pid) {
            $child_exit = $? >> 8;
            last;
        }
        select(undef, undef, undef, 0.1);
    }
    if (!$timed_out && waitpid($pid, WNOHANG) == 0) {
        my $reaped = waitpid($pid, 0);
        $child_exit = $? >> 8 if $reaped == $pid;
    } elsif ($timed_out && kill(0, $pid)) {
        kill('KILL', $pid);
        waitpid($pid, 0);
    }

    my $stdout = '';
    if (open my $fh, '<', "$tmp_dir/stdout.txt") {
        local $/; $stdout = <$fh>; close $fh;
    }
    my $stderr = '';
    if (open my $fh, '<', "$tmp_dir/stderr.txt") {
        local $/; $stderr = <$fh>; close $fh;
    }

    # Side-effect check
    my $se_msg = '';
    my $tmp_paths = extract_tmp_paths($test_file);
    if (@$tmp_paths) {
        my $after = snapshot_paths($tmp_paths);
        my @missing;
        for my $p (@$tmp_paths) {
            push @missing, $p if $after->{$p} eq 'MISSING';
        }
        if (@missing) {
            $se_msg = 'side-effect: missing /tmp/ files: ' . join(', ', @missing);
        }
    }

    remove_tree($tmp_dir);

    my $result;
    if ($timed_out) {
        $result = { status => 'TIMEOUT', detail => "exceeded ${timeout_per_test}s" };
    } elsif ($child_exit != 0) {
        my $reason = $stderr || $stdout;
        $reason =~ s/\n/ /g;
        $reason = substr($reason, 0, 200);
        if ($se_msg) { $reason .= " ($se_msg)"; }
        $result = { status => 'FAIL', detail => "exit=$child_exit $reason" };
    } elsif ($se_msg) {
        $result = { status => 'FAIL', detail => $se_msg, side_effect => 1 };
    } else {
        $result = { status => 'PASS', detail => '' };
    }

    return $result;
}

# ── Main ────────────────────────────────────────────────────────────

print "Running $total tests, $jobs parallel workers, ${timeout_per_test}s timeout each\n";
print "Examples dir: $examples\n";
print "Debashc: $debashc\n";
print "----------------------------------------\n";

print "Building debashc...\n";
my $build_out = `cd '$sh2perl' && cargo build --bin debashc 2>&1`;
if ($? != 0) {
    print $build_out;
    die "Build failed\n";
}
print "Build complete.\n\n";

my $work_dir = tempdir("failtest-XXXXXXXX", CLEANUP => 1, DIR => "/tmp");

# Map from child PID to { test_num => N, test_name => "str", res_file => "path" }
my %child_info;
my $next_idx = 0;

# Helper: dispatch one test
sub dispatch {
    my ($idx) = @_;
    my $test_file = $all_tests[$idx];
    my $test_name = basename($test_file);
    my $test_num  = $idx + 1;

    # Fork a child that runs the test, writes result JSON, then exits.
    my $pid = fork;
    if (!defined $pid) { die "fork: $!"; }

    if ($pid == 0) {
        my $result = run_one_test($test_file, $test_name, $test_num, $work_dir);
        $result->{file} = $test_name;

        require JSON::PP;
        my $res_file = "$work_dir/result_$test_num.json";
        open my $rfh, '>', $res_file or die "write $res_file: $!";
        print $rfh JSON::PP::encode_json($result);
        close $rfh;

        exit(0);
    }

    $child_info{$pid} = {
        test_num  => $test_num,
        test_name => $test_name,
        res_file  => "$work_dir/result_$test_num.json",
    };
}

# Dispatch initial batch
while ($next_idx < $total && scalar(keys %child_info) < $jobs) {
    dispatch($next_idx);
    $next_idx++;
}

# Helper to print result for a completed child
sub print_result {
    my ($info) = @_;
    my $res_file = $info->{res_file};
    my $test_name = $info->{test_name};
    my $test_num  = $info->{test_num};

    my $result;
    if (open my $rfh, '<', $res_file) {
        local $/;
        my $json = <$rfh>;
        close $rfh;
        $result = eval { JSON::PP::decode_json($json) };
    }

    unless ($result) {
        $result = { status => 'FAIL', detail => 'missing result', file => $test_name };
    }

    push @results, $result;

    my $mark = $result->{status} eq 'PASS' ? 'TEST PASSED'
             : $result->{status} eq 'TIMEOUT' ? "TIMEOUT (${timeout_per_test}s)"
             : 'FAIL';

    printf "[%d/%d] %s ... %s", $test_num, $total, $test_name, $mark;
    if ($result->{detail}) {
        my $d = $result->{detail};
        $d =~ s/\n/ /g;
        $d = substr($d, 0, 200);
        printf ": %s", $d;
    }
    print "\n";
}

require JSON::PP;

# Main reap-dispatch loop
while (scalar(keys %child_info) > 0) {
    my $reaped = waitpid(-1, 0);
    last if $reaped <= 0;

    if (exists $child_info{$reaped}) {
        my $info = delete $child_info{$reaped};
        print_result($info);
    }

    # Dispatch more work
    while ($next_idx < $total && scalar(keys %child_info) < $jobs) {
        dispatch($next_idx);
        $next_idx++;
    }
}

# Tally
for my $r (@results) {
    if ($r->{status} eq 'PASS')       { $passed++; }
    elsif ($r->{status} eq 'TIMEOUT') { $timed++; }
    else                              { $failed++; $side_effect_fails++ if $r->{side_effect}; }
}

print "\n========================================\n";
my $extra = $side_effect_fails ? " ($side_effect_fails side-effect)" : '';
print "TESTS COMPLETED: $passed passed, " . ($failed + $timed) . " failed out of $total$extra\n";
print "========================================\n";

if ($failed || $timed) {
    print "\nFAILED TESTS:\n";
    for my $r (@results) {
        next if $r->{status} eq 'PASS';
        my $reason = $r->{status} eq 'TIMEOUT' ? "Timed out after ${timeout_per_test}s" : $r->{detail};
        printf "  FAIL: %s [perl] — %s\n", $r->{file}, $reason;
    }
}

exit ($failed || $timed ? 1 : 0);
