#!/usr/bin/env perl
use strict;
use warnings;
use Cwd qw(abs_path getcwd);
use File::Basename qw(basename dirname);
use File::Path qw(make_path remove_tree);
use File::Temp qw(tempdir);
use POSIX qw(:sys_wait_h);

$| = 1;

my $root = dirname(abs_path($0));
my $sh2perl = "$root/sh2perl";
# The transpiler CLI is otranspilerl (the Optimising Transpiler — PLAN
# §11.8 / "migrate to otranspiler only"): it renders the same shIR
# pipeline (byte-identical output, verified) without the legacy CLI
# Generator paths.
my $otranspilerl = "$root/otranspilerl/target/debug/otranspilerl-cli";
# Corpus override: FAIL_CORPUS=/path/to/dir runs only that corpus (used by
# ./fail-coreutils for the workspace-side GNU coreutils regression tests in
# tests/coreutils/). Defaults to the sh2perl examples corpus.
my $examples = $ENV{FAIL_CORPUS} // "$sh2perl/examples";
my $timeout_per_test = 20;   # seconds per individual test (align with fail-estree)
my $ncpus = 1;
if (open my $fh, '<', '/proc/cpuinfo') {
    my @lines = grep { /^processor\s*:/ } <$fh>;
    $ncpus = scalar @lines || 1;
    close $fh;
}
my $jobs = int($ncpus / 2);
$jobs = 1 if $jobs < 1;

# ── Worker allocation (harness/WorkerPool.pm): 50%-of-RAM ceiling, loadavg
#    dynamic shrink, and cgroup enforcement (on by default; best-effort —
#    falls back to cooperative accounting when cgroups aren't writable,
#    e.g. unprivileged WSL). The pool is SHARED across concurrent gates via
#    .workers/ slot files, so N agent loops running gates simultaneously
#    can't each spawn int(nproc/2) workers. The agent windows themselves
#    stay outside the pool (they're the priority class).
my $pool_ok = eval { require "$root/harness/WorkerPool.pm"; 1 };
if ($pool_ok) {
    WorkerPool::init(root => $root);
    WorkerPool::enter_cgroup();   # before forking: workers inherit membership
    $jobs = WorkerPool::acquire($jobs);
}
END { WorkerPool::release() if $pool_ok; }

# Dynamic budget, recomputed per dispatch batch: loadavg can change
# mid-run (agents waking up, sibling gates finishing); the cgroup weight +
# this keep the gates yielding to the box's other work.
sub current_jobs {
    return $pool_ok ? WorkerPool::max_jobs($jobs) : $jobs;
}

my @all_tests = glob "$examples/*.sh";
@all_tests = sort @all_tests;

if (@ARGV) {
    my $prefix = $ARGV[0];
    @all_tests = grep { index(basename($_), $prefix) != -1 } @all_tests;
}

my $total   = scalar @all_tests;
my $passed  = 0;
my $failed  = 0;
my $timed   = 0;
my $side_effect_fails = 0;
my @results = ();

# ── Side-effect checking helpers ─────────────────────────────────────

sub extract_tmp_paths {
    my ($file) = @_;
    open my $fh, '<', $file or return [];
    my $content = do { local $/; <$fh> };
    close $fh;
    my @paths;
    while ($content =~ m{/tmp/[-_.a-zA-Z0-9/+*?]+}g) {
        my $path = $&;
        next if $path =~ /[*?]/;
        next if $path =~ /XXXXXX/;
        next if $path =~ m{/tmp/\*};
        next if $path =~ m{/tmp/temp_};
        $path =~ s{[^a-zA-Z0-9_./+-]\$}{};
        push @paths, $path;
    }
    my %seen;
    @paths = grep { !$seen{$_}++ } @paths;
    return \@paths;
}

sub snapshot_paths {
    my ($paths) = @_;
    my %snap;
    for my $p (@$paths) {
        my @matches = glob $p;
        if (@matches) {
            for my $m (@matches) {
                if (-f $m && !-l $m) {
                    my $hash = `sha256sum "$m" 2>/dev/null`;
                    chomp $hash;
                    $snap{$m} = $hash;
                } else {
                    $snap{$m} = 'EXISTS';
                }
            }
        } elsif (-e $p) {
            if (-f $p && !-l $p) {
                my $hash = `sha256sum "$p" 2>/dev/null`;
                chomp $hash;
                $snap{$p} = $hash;
            } else {
                $snap{$p} = 'EXISTS';
            }
        } else {
            $snap{$p} = 'MISSING';
        }
    }
    return \%snap;
}

# ── Run a single test (fork + exec) ─────────────────────────────────

sub run_one_test {
    my ($test_file, $test_name, $test_num, $work_dir) = @_;

    my $tmp_dir = "$work_dir/test_$test_num";
    make_path($tmp_dir);

    # Snapshot /tmp paths referenced by the script BEFORE anything runs, so the
    # side-effect check can distinguish "script cleaned up after itself"
    # (missing before AND after) from "script deleted a pre-existing file"
    # (existed before, missing after) and "script left litter" (missing before,
    # exists after).
    my $tmp_paths = extract_tmp_paths($test_file);
    my $before_snapshot = @$tmp_paths ? snapshot_paths($tmp_paths) : undef;

    # Step 1: Run otranspilerl to generate Perl code (the whole stdout IS
    # the Perl — no banner to strip)
    my $gen_out = `timeout $timeout_per_test sh -c '"$otranspilerl" --target pl "$test_file" 2>/dev/null'`;
    if ($? != 0 && !defined $gen_out) {
        remove_tree($tmp_dir);
        return { status => 'FAIL', detail => 'otranspilerl timed out' };
    }
    if ($? != 0) {
        remove_tree($tmp_dir);
        return { status => 'FAIL', detail => 'otranspilerl failed to generate code' };
    }

    # Extract Perl code: the whole stdout (otranspilerl has no banner)
    my $perl_code = $gen_out;

    # The generated programs' external-command seam (UU-FFI.md): point the
    # BEGIN probe at the built libcoreutils_ffi.so when present, so the
    # gate exercises the in-process coreutils arm; absent/invalid → the
    # guarded fork/exec fallback still runs (both-mode parity checked in
    # runtime/tests/).
    local $ENV{SH2_UU_LIB} = "$root/sh2perl/runtime/lib/libcoreutils_ffi.so";

    # Gate: reject the bash-wrapper fallback. When the parser cannot parse a
    # script it emits `system('bash', '<file>')` instead of real Perl
    # (src/main.rs "falling back to bash wrapper"); the stdout comparison
    # would then match bash trivially, hiding the parser gap. Treat it as
    # a FAIL so parser gaps stay visible (see tests/coreutils/README.md).
    if ($perl_code =~ /system\('bash',\s*'[^']*'\)/) {
        remove_tree($tmp_dir);
        return { status => 'FAIL', detail => 'parser fallback (script wrapped in bash call)' };
    }

    # Step 2: Write Perl code to temp file and run it
    my $perl_file = "$tmp_dir/test.pl";
    open my $pfh, '>', $perl_file or die "write $perl_file: $!";
    print $pfh $perl_code;
    close $pfh;

    # Gate: run check_qx on the generated Perl before testing it
    my $check_qx = "$root/check_qx.pl";
    if (-f $check_qx) {
        my $qx_out = `perl "$check_qx" "$perl_file" 2>/dev/null`;
        my $qx_exit = $? >> 8;
        if ($qx_exit != 0) {
            my @lines = grep { /FAIL/ } split /\n/, $qx_out;
            my $detail = 'check_qx: ' . ($lines[0] // 'violation');
            remove_tree($tmp_dir);
            return { status => 'FAIL', detail => $detail };
        }
    }

    # Run Perl with 5.010 features and capture stdout/stderr. argv0 must be
    # the SOURCE script path (what `bash '$test_file'` sees below) — $0 is
    # argv0 pass-through, so $0-dependent output ($0, ${0##*/}, dirname $0)
    # agrees with bash. `do $ARGV[0]` runs the generated file in the main
    # scope with @ARGV emptied (no positional args, like bash).
    my ($perl_out, $perl_stdout, $perl_stderr);
    $perl_out = `timeout $timeout_per_test perl -M5.010 -e '\$0 = shift \@ARGV; my \$__f = shift \@ARGV; do \$__f' '$test_file' '$perl_file' 2>"$tmp_dir/perl_stderr.txt"`;
    my $perl_exit = $? >> 8;
    if (open my $fh, '<', "$tmp_dir/perl_stderr.txt") {
        local $/; $perl_stderr = <$fh>; close $fh;
    } else {
        $perl_stderr = q{};
    }
    $perl_stdout = $perl_out // q{};

    # Step 3: Run bash on the original script with timeout
    my $bash_out;
    my $bash_exit;
    $bash_out = `timeout $timeout_per_test bash '$test_file' 2>"$tmp_dir/bash_stderr.txt"`;
    $bash_exit = $? >> 8;
    my $bash_stdout = $bash_out // q{};
    my $bash_stderr = '';
    if (open my $fh, '<', "$tmp_dir/bash_stderr.txt") {
        local $/; $bash_stderr = <$fh>; close $fh;
    }

    # Step 4: Compare stdout BYTE-FOR-BYTE (both sides run on Linux; no
    # whitespace normalization — differences are real renderer bugs).
    my $stdout_match = $perl_stdout eq $bash_stdout;

    # Step 5: Side-effect check (before/after snapshot)
    my $se_msg = '';
    if ($before_snapshot && @$tmp_paths) {
        my $after = snapshot_paths($tmp_paths);
        my @problems;
        for my $p (@$tmp_paths) {
            my $b = $before_snapshot->{$p} // 'MISSING';
            my $a = $after->{$p} // 'MISSING';
            if ($b eq 'MISSING' && $a ne 'MISSING') {
                push @problems, "$p created (litter left behind)";
            } elsif ($b ne 'MISSING' && $a eq 'MISSING') {
                push @problems, "$p deleted (pre-existing file removed)";
            }
        }
        if (@problems) {
            $se_msg = 'side-effect: ' . join(', ', @problems);
        }
    }

    # Step 6: Determine result
    my @reasons;
    push @reasons, 'stdout mismatch' if !$stdout_match;
    push @reasons, "exit code (bash=$bash_exit perl=$perl_exit)" if defined($bash_exit) && defined($perl_exit) && $bash_exit != $perl_exit;
    push @reasons, $se_msg if $se_msg;

    my $result;
    if (@reasons) {
        $result = { status => 'FAIL', detail => join(', ', @reasons) };
    } else {
        $result = { status => 'PASS', detail => '' };
    }

    remove_tree($tmp_dir);
    return $result;
}

# ── Main ────────────────────────────────────────────────────────────

print "Running $total tests, $jobs parallel workers, ${timeout_per_test}s timeout each\n";
if ($pool_ok) {
    print "Worker pool: $jobs workers (", WorkerPool::status(), ")\n";
}
print "Examples dir: $examples\n";
print "Transpiler: $otranspilerl\n";
print "----------------------------------------\n";

print "Building otranspilerl-cli...\n";
my $build_out = `'$root/harness/build-lock.sh' --role core -- bash -c 'cd "\$1" && cargo build --bin otranspilerl-cli 2>&1' _ '$root/otranspilerl'`;
if ($? != 0) {
    print $build_out;
    die "Build failed\n";
}
print "Build complete.\n\n";

my $work_dir = tempdir("failtest-XXXXXXXX", CLEANUP => 1, DIR => "/tmp");

# Map from child PID to { test_num => N, test_name => "str", res_file => "path" }
my %child_info;
my $next_idx = 0;

# Helper: dispatch one test
sub dispatch {
    my ($idx) = @_;
    my $test_file = $all_tests[$idx];
    my $test_name = basename($test_file);
    my $test_num  = $idx + 1;

    # Fork a child that runs the test, writes result JSON, then exits.
    my $pid = fork;
    if (!defined $pid) { die "fork: $!"; }

    if ($pid == 0) {
        my $result = run_one_test($test_file, $test_name, $test_num, $work_dir);
        $result->{file} = $test_name;

        require JSON::PP;
        my $res_file = "$work_dir/result_$test_num.json";
        open my $rfh, '>', $res_file or die "write $res_file: $!";
        print $rfh JSON::PP::encode_json($result);
        close $rfh;

        exit(0);
    }

    $child_info{$pid} = {
        test_num  => $test_num,
        test_name => $test_name,
        res_file  => "$work_dir/result_$test_num.json",
    };
}

# Dispatch initial batch
while ($next_idx < $total && scalar(keys %child_info) < current_jobs()) {
    dispatch($next_idx);
    $next_idx++;
}

# Helper to print result for a completed child
sub print_result {
    my ($info) = @_;
    my $res_file = $info->{res_file};
    my $test_name = $info->{test_name};
    my $test_num  = $info->{test_num};

    my $result;
    if (open my $rfh, '<', $res_file) {
        local $/;
        my $json = <$rfh>;
        close $rfh;
        $result = eval { JSON::PP::decode_json($json) };
    }

    unless ($result) {
        $result = { status => 'FAIL', detail => 'missing result', file => $test_name };
    }

    push @results, $result;

    my $mark = $result->{status} eq 'PASS' ? 'TEST PASSED'
             : $result->{status} eq 'TIMEOUT' ? "TIMEOUT (${timeout_per_test}s)"
             : 'FAIL';

    printf "[%d/%d] %s ... %s", $test_num, $total, $test_name, $mark;
    if ($result->{detail}) {
        my $d = $result->{detail};
        $d =~ s/\n/ /g;
        $d = substr($d, 0, 200);
        printf ": %s", $d;
    }
    print "\n";
}

require JSON::PP;

# Main reap-dispatch loop
while (scalar(keys %child_info) > 0) {
    my $reaped = waitpid(-1, 0);
    last if $reaped <= 0;

    if (exists $child_info{$reaped}) {
        my $info = delete $child_info{$reaped};
        print_result($info);
    }

    # Dispatch more work (dynamic: shrinks when loadavg rises)
    while ($next_idx < $total && scalar(keys %child_info) < current_jobs()) {
        dispatch($next_idx);
        $next_idx++;
    }
}

# Tally
for my $r (@results) {
    if ($r->{status} eq 'PASS')       { $passed++; }
    elsif ($r->{status} eq 'TIMEOUT') { $timed++; }
    else                              { $failed++; $side_effect_fails++ if $r->{side_effect}; }
}

print "\n========================================\n";
my $extra = $side_effect_fails ? " ($side_effect_fails side-effect)" : '';
print "TESTS COMPLETED: $passed passed, " . ($failed + $timed) . " failed out of $total$extra\n";
print "========================================\n";

if ($failed || $timed) {
    print "\nFAILED TESTS:\n";
    for my $r (@results) {
        next if $r->{status} eq 'PASS';
        my $reason = $r->{status} eq 'TIMEOUT' ? "Timed out after ${timeout_per_test}s" : $r->{detail};
        printf "  FAIL: %s [perl] — %s\n", $r->{file}, $reason;
    }
}

exit ($failed || $timed ? 1 : 0);
