#!/usr/bin/env bash
# RED test: POSIX default-value parameter expansion `${var:=default}` (and
# the `:-` / `:?` / `:+` family) currently lowers to sh2.unsupported in
# the ESTree emitter. This is the single dominant lowering gap in the GNU
# coreutils corpus: 645 of 650 test scripts hit it once, from
# `. "${srcdir=.}/tests/init.sh"` (tests/README.md).
#
# Expected behavior today: sh2.unsupported is present → script exits 1
# (red). When src/estree.rs lowers the family, flip the grep below to
# assert the marker is GONE and the script goes green.
#
# NOTE (2026-11-09): this test could not fail. `debashc` is not built in
# this workspace, `|| true` swallowed that, and EMPTY output contains no
# `"name":"unsupported"` marker — so it printed PASS and exited 0 on a box
# where the binary it measures did not exist. A missing binary and an empty
# render are now failures of this test, not evidence of a fix.
# (Measured the same day: `otranspilerl --target estree` on
# `echo ${x:=default}` emits NO unsupported marker, so the claim above is
# stale for that CLI; this test still measures debashc, which is not built.)
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
debashc="$root/sh2perl/target/debug/debashc"

tmp="$(mktemp /tmp/estree-default-param.XXXXXX.sh)"
trap 'rm -f "$tmp"' EXIT
printf 'echo ${x:=default}\n' > "$tmp"

if [ ! -x "$debashc" ]; then
    echo "FAIL: debashc is not built at $debashc — this test cannot run."
    echo "  fix: build it, or point this test at the CLI the gates use"
    echo "  (otranspilerl --target estree), whose lowering differs."
    exit 1
fi
out="$("$debashc" file --estree "$tmp" 2>/dev/null || true)"
if [ -z "$out" ]; then
    echo "FAIL: debashc produced no estree output (exit was not recorded)"
    exit 1
fi
if printf '%s' "$out" | command grep -q '"name":"unsupported"'; then
    echo "FAIL (expected): \${x:=default} still lowers to sh2.unsupported"
    echo "  fix target: src/estree.rs word lowering for AssignDefault/Default"
    echo "  then flip this check to assert the marker is absent"
    exit 1
fi
echo "PASS: \${x:=default} no longer lowers to sh2.unsupported"
