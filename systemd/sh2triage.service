[Unit]
Description=sh2loop — cross-product triage worker (frontend corpus x backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__SH2LOOP_ROOT__
# cargo is NOT on systemd's default PATH; without this every build fails
# instantly with "cargo: command not found" and an empty log. See sh2fleet.env.
EnvironmentFile=__SH2LOOP_ROOT__/systemd/sh2fleet.env
# Put the worker in the throttled IO slice. Without this every worker sat in
# /init.scope, the slice held procs=0, and the io.max caps guarded nothing.
# supervise.sh ALSO self-joins the slice (so the zellij-pane launch path is
# covered too); this line is the declarative, boot-surviving half. Keep both.
Slice=sh2-io.slice
ExecStart=__SH2LOOP_ROOT__/harness/supervise.sh \
  --name triage \
  --log __SH2LOOP_ROOT__/loop-triage-worker.log \
  --pidfile __SH2LOOP_ROOT__/loop-triage-worker.pid \
  -- \
  __SH2LOOP_ROOT__/run_triage_worker.sh
Restart=always
RestartSec=10
StandardOutput=append:__SH2LOOP_ROOT__/loop-triage-worker.log
StandardError=append:__SH2LOOP_ROOT__/loop-triage-worker.log

[Install]
WantedBy=default.target
