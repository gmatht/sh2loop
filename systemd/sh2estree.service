[Unit]
Description=sh2loop — ESTree backend repair loop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__SH2LOOP_ROOT__
# cargo is NOT on systemd's default PATH; without this every build fails
# instantly with "cargo: command not found" and an empty log. See sh2fleet.env.
EnvironmentFile=__SH2LOOP_ROOT__/systemd/sh2fleet.env
# Put the worker in the throttled IO slice. Without this every worker sat in
# /init.scope, the slice held procs=0, and the io.max caps guarded nothing.
# supervise.sh ALSO self-joins the slice (so the zellij-pane launch path is
# covered too); this line is the declarative, boot-surviving half. Keep both.
Slice=sh2-io.slice
# Route the AI call through harness/ai_invoke.py: phase-selected model,
# Laguna daily-quota fallback, and token telemetry. Without this the loop
# calls `pir` directly, which ignores a stdin prompt and has no fallback
# -- see the MODEL ROTATION block in systemd/sh2fleet.env.
Environment=WORKER_ROTATE_WORKER=estree
ExecStart=__SH2LOOP_ROOT__/harness/supervise.sh \
  --name estree \
  --log __SH2LOOP_ROOT__/loop-estree.log \
  --pidfile __SH2LOOP_ROOT__/loop-estree-worker.pid \
  -- \
  /usr/bin/perl __SH2LOOP_ROOT__/main_loop_estree.pl
Restart=always
RestartSec=10
StandardOutput=append:__SH2LOOP_ROOT__/loop-estree.log
StandardError=append:__SH2LOOP_ROOT__/loop-estree.log

[Install]
WantedBy=default.target
