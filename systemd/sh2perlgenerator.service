[Unit]
Description=sh2loop — perl GENERATOR repair worker (the finished renderer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__SH2LOOP_ROOT__
# cargo is NOT on systemd's default PATH; without this every build fails
# instantly with "cargo: command not found" and an empty log. See sh2fleet.env.
EnvironmentFile=__SH2LOOP_ROOT__/systemd/sh2fleet.env
# Throttled IO slice — the gate builds otranspilerl-cli and runs 555 examples.
Slice=sh2-io.slice
# Model rotation: phase-selected model, Laguna daily-quota fallback, token
# telemetry. Without this the worker calls pir directly, which has no fallback.
Environment=WORKER_ROTATE_WORKER=perl-generator
ExecStart=__SH2LOOP_ROOT__/harness/supervise.sh \
  --name perl-generator \
  --log __SH2LOOP_ROOT__/loop-perl-generator.log \
  --pidfile __SH2LOOP_ROOT__/loop-perl-generator.pid \
  -- \
  __SH2LOOP_ROOT__/run_perl_generator_worker.sh
Restart=always
RestartSec=10
StandardOutput=append:__SH2LOOP_ROOT__/loop-perl-generator.log
StandardError=append:__SH2LOOP_ROOT__/loop-perl-generator.log

[Install]
WantedBy=default.target
