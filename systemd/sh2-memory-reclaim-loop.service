[Unit]
Description=Reclaim sh2loop harness page cache against memory.high
Documentation=file://__SH2LOOP_ROOT__/AGENTS.md
# Deliberately NOT the same unit as the boot-time memory.high oneshot: that
# one applies a bound, this one continuously reclaims against it. A
# persistent loop is run as a long-lived Type=simple service, NOT as a
# Type=oneshot — a oneshot is expected to exit, so systemd kills it at
# TimeoutStartSec and marks the unit failed every tick. Measured exactly
# that: "Main process exited, code=killed, status=15/TERM / Failed with
# result 'timeout'" on every run, which buries the real signal in a
# permanently failing unit.

[Service]
# Type=simple (not oneshot): this process loops forever by design. The
# timer fires the START; the unit is allowed to run between ticks.
Type=simple
ExecStart=__SH2LOOP_ROOT__/harness/sh2-memory-reclaim.sh
# A memory janitor is never urgent work.
Nice=19
IOSchedulingClass=idle
# No TimeoutStartSec: the process is meant to stay up until the next
# tick's start, and systemd restarting a still-running instance is what
# produced the failure loop above.
Restart=on-failure
RestartSec=30
