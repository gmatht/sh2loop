[Unit]
Description=Disk high-water check for the sh2loop harness root filesystem
Documentation=file://__SH2LOOP_ROOT__/AGENTS.md
# Reports only — it never deletes. A full disk is an operator decision, so
# this exists to be READ (journalctl -u sh2-disk-guard), not to act.
After=local-fs.target

[Service]
Type=oneshot
ExecStart=__SH2LOOP_ROOT__/harness/sh2-disk-guard.sh
# The breakdown path can take minutes; the fast path is ~20ms. Generous
# ceiling so an opt-in triage never kills the unit mid-walk.
TimeoutStartSec=300
# Never compete with a live harness run for the disk it is measuring.
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
