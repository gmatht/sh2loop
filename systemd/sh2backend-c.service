[Unit]
Description=sh2loop — C backend repair worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/llm/sh2loop
# cargo is NOT on systemd's default PATH; without this every build fails
# instantly with "cargo: command not found" and an empty log. See sh2fleet.env.
EnvironmentFile=/home/llm/sh2loop/systemd/sh2fleet.env
# Put the worker in the throttled IO slice. Without this every worker sat in
# /init.scope, the slice held procs=0, and the io.max caps guarded nothing.
# supervise.sh ALSO self-joins the slice (so the zellij-pane launch path is
# covered too); this line is the declarative, boot-surviving half. Keep both.
Slice=sh2-io.slice
ExecStart=/home/llm/sh2loop/harness/supervise.sh \
  --name backend-c \
  --log /home/llm/sh2loop/loop-backend-c.log \
  --pidfile /home/llm/sh2loop/loop-backend-c.pid \
  -- \
  /home/llm/sh2loop/setup_backends.sh --run-backend-worker c
Restart=always
RestartSec=10
StandardOutput=append:/home/llm/sh2loop/loop-backend-c.log
StandardError=append:/home/llm/sh2loop/loop-backend-c.log

[Install]
WantedBy=default.target
