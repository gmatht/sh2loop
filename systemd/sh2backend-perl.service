[Unit]
Description=sh2loop — PERL backend repair worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/llm/sh2loop
ExecStart=/home/llm/sh2loop/harness/supervise.sh \
  --name backend-perl \
  --log /home/llm/sh2loop/loop-backend-perl.log \
  --pidfile /home/llm/sh2loop/loop-backend-perl.pid \
  -- \
  /home/llm/sh2loop/setup_backends.sh --run-backend-worker perl
Restart=always
RestartSec=10
StandardOutput=append:/home/llm/sh2loop/loop-backend-perl.log
StandardError=append:/home/llm/sh2loop/loop-backend-perl.log

[Install]
WantedBy=default.target
